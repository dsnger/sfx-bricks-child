#. Theme Name of the theme
#: style.css
msgid "Smilefx Bricks Child Theme"
msgstr "Smilefx Bricks Child Theme"

#. Theme URI of the theme
#. Author URI of the theme
#: style.css
msgid "https://smilefx.io/"
msgstr "https://smilefx.io/"

#. Description of the theme
#: style.css
msgid ""
"A powerful child theme for Bricks, designed to extend and customize your "
"WordPress site with advanced features, performance optimizations, and "
"seamless integration with enhanced tools."
msgstr ""
"Ein leistungsstarkes Child-Theme für Bricks, das deine WordPress-Website mit "
"erweiterten Funktionen, Performance-Optimierungen und nahtloser Integration "
"verbesserter Werkzeuge ausbaut und anpasst."

#. Author of the theme
#: style.css
msgid "Daniel Sänger (smilefx.io)"
msgstr "Daniel Sänger (smilefx.io)"

