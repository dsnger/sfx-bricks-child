msgstr ""

#: inc/SiteCheck/Catalogue.php:78
msgid ".git and .env files"
msgstr ""

#: inc/SiteCheck/Catalogue.php:79
msgid "A readable .git folder can give away the whole source code; a .env file usually holds passwords and API keys."
msgstr ""

#: inc/SiteCheck/Catalogue.php:80
