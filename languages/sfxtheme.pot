#: inc/WPOptimizer/Settings.php:38
msgid "Disable Search"
msgstr ""

#: inc/WPOptimizer/Settings.php:39
msgid "Disables the default WordPress search feature. Useful for brochure sites or when search is not needed. Not recommended for content-heavy or blog sites."
msgstr ""

#: inc/WPOptimizer/Settings.php:46
msgid "Allow Lottie JSON Files"
msgstr ""

#: inc/WPOptimizer/Settings.php:47
msgid "Allows uploading of JSON files (e.g., for Lottie animations) and plain text files. Enable if you need to upload these file types. Only recommended if you trust your site's users, as JSON can contain sensitive data."
msgstr ""

#: inc/WPOptimizer/Settings.php:55
msgid "Disable jQuery"
msgstr ""

#: inc/WPOptimizer/Settings.php:56
msgid "Removes jQuery from the frontend to improve performance. Only enable if your theme and plugins do not require jQuery. Not recommended unless you are certain no scripts depend on jQuery."
msgstr ""

#: inc/WPOptimizer/Settings.php:63
msgid "Load jQuery in Footer"
msgstr ""

#: inc/WPOptimizer/Settings.php:64
msgid "Loads jQuery in the footer instead of the header, improving page load speed. Recommended if your scripts do not require jQuery to be loaded early."
msgstr ""

#: inc/WPOptimizer/Settings.php:71
msgid "Disable jQuery Migrate"
msgstr ""

#: inc/WPOptimizer/Settings.php:72
msgid "Removes jQuery Migrate, which provides backward compatibility for older scripts. Recommended unless you use plugins or themes that require legacy jQuery features."
msgstr ""

#: inc/WPOptimizer/Settings.php:79
msgid "Remove Thumbnail Dimensions"
msgstr ""

#: inc/WPOptimizer/Settings.php:80
msgid "Removes width and height attributes from thumbnail images for better responsive design. Recommended for modern, responsive themes."
msgstr ""

#: inc/WPOptimizer/Settings.php:87
msgid "Remove Nav Menu Container"
msgstr ""

#: inc/WPOptimizer/Settings.php:88
msgid "Removes the default <div> container from wp_nav_menu output. Useful for cleaner HTML and easier CSS styling."
msgstr ""

#: inc/WPOptimizer/Settings.php:95
msgid "Remove Caption Width"
msgstr ""

#: inc/WPOptimizer/Settings.php:96
msgid "Removes inline width styling from image captions, allowing for more flexible and responsive layouts."
msgstr ""

#: inc/WPOptimizer/Settings.php:103
msgid "Handle Shortcode Formatting"
msgstr ""

#: inc/WPOptimizer/Settings.php:104
msgid "Prevents WordPress from wrapping shortcodes in unwanted <p> or <br> tags, which can break layout. Recommended if you use shortcodes in content."
msgstr ""

#: inc/WPOptimizer/Settings.php:111
msgid "Remove Archive Title Prefix"
msgstr ""

#: inc/WPOptimizer/Settings.php:112
msgid "Removes prefixes like \"Category:\" or \"Archive:\" from archive titles for cleaner headings."
msgstr ""

#: inc/WPOptimizer/Settings.php:119
msgid "Add Slug to Body Class"
msgstr ""

#: inc/WPOptimizer/Settings.php:120
msgid "Adds the post or page slug to the <body> class attribute. Useful for targeted CSS styling."
msgstr ""

#: inc/WPOptimizer/Settings.php:127
msgid "Block External HTTP"
msgstr ""

#: inc/WPOptimizer/Settings.php:128
msgid "Blocks all outgoing HTTP requests from the frontend for security or privacy. Only enable if you do not need to fetch external resources (e.g., APIs, fonts)."
msgstr ""

#: inc/WPOptimizer/Settings.php:135
msgid "Defer CSS"
msgstr ""

#: inc/WPOptimizer/Settings.php:136
msgid "Loads CSS files asynchronously to improve perceived page load speed. May cause a flash of unstyled content (FOUC). Recommended for advanced users."
msgstr ""

#: inc/WPOptimizer/Settings.php:143
msgid "Defer JS"
msgstr ""

#: inc/WPOptimizer/Settings.php:144
msgid "Adds the defer attribute to all scripts, improving page load performance. Not recommended if you have scripts that must run before page render."
msgstr ""

#: inc/WPOptimizer/Settings.php:151
msgid "Disable Comments"
msgstr ""

#: inc/WPOptimizer/Settings.php:152
msgid "Disables all comment features site-wide. Recommended for sites that do not use comments."
msgstr ""

#: inc/WPOptimizer/Settings.php:160
msgid "Disable Emoji"
msgstr ""

#: inc/WPOptimizer/Settings.php:161
msgid "Removes WordPress emoji scripts and styles to reduce page size. Recommended unless you need emoji support."
msgstr ""

#: inc/WPOptimizer/Settings.php:168
msgid "Disable Feeds"
msgstr ""

#: inc/WPOptimizer/Settings.php:169
msgid "Disables all RSS and Atom feeds. Recommended for private or brochure sites. Not recommended for blogs or news sites."
msgstr ""

#: inc/WPOptimizer/Settings.php:176
msgid "Remove REST discovery links and oEmbed"
msgstr ""

#: inc/WPOptimizer/Settings.php:177
msgid "Removes the REST and oEmbed discovery links, the oEmbed route and JSONP. It does not block REST requests — WordPress ignores that since 4.7. To restrict guests, use “REST API access for guests”."
msgstr ""

#: inc/WPOptimizer/Settings.php:184
msgid "Disable RSD Links"
msgstr ""

#: inc/WPOptimizer/Settings.php:185
msgid "Removes the Really Simple Discovery (RSD) link from the header. Recommended for security."
msgstr ""

#: inc/WPOptimizer/Settings.php:192
msgid "Disable Shortlinks"
msgstr ""

#: inc/WPOptimizer/Settings.php:193
msgid "Removes the shortlink meta tag from the header. Recommended for privacy or SEO reasons."
msgstr ""

#: inc/WPOptimizer/Settings.php:200
msgid "Disable Theme Editor"
msgstr ""

#: inc/WPOptimizer/Settings.php:201
msgid "Disables the built-in theme and plugin editor in the admin for security. Recommended for production sites."
msgstr ""

#: inc/WPOptimizer/Settings.php:208
msgid "Disable Version Query Args"
msgstr ""

#: inc/WPOptimizer/Settings.php:209
msgid "Removes version query strings from scripts and styles to improve caching. Off by default because it can break cache busting after WordPress or plugin updates."
msgstr ""

#: inc/WPOptimizer/Settings.php:216
msgid "Disable WLW Manifest"
msgstr ""

#: inc/WPOptimizer/Settings.php:217
msgid "Removes the Windows Live Writer manifest link from the header. Recommended for security."
msgstr ""

#: inc/WPOptimizer/Settings.php:224
msgid "Disable WP Version"
msgstr ""

#: inc/WPOptimizer/Settings.php:225
msgid "Removes the WordPress version meta tag for security."
msgstr ""

#: inc/WPOptimizer/Settings.php:232
msgid "Disable XMLRPC"
msgstr ""

#: inc/WPOptimizer/Settings.php:233
msgid "Disables XML-RPC, which is often targeted by attackers. Recommended unless you use remote publishing or pingbacks."
msgstr ""

#: inc/WPOptimizer/Settings.php:240
msgid "Disable DNS Prefetch"
msgstr ""

#: inc/WPOptimizer/Settings.php:241
msgid "Removes DNS prefetch resource hints from the header. May slightly reduce DNS lookups, but can impact performance for some resources."
msgstr ""

#: inc/WPOptimizer/Settings.php:248
msgid "Limit Revisions"
msgstr ""

#: inc/WPOptimizer/Settings.php:249
msgid "Limits the number of post revisions to reduce database size. Recommended for performance."
msgstr ""

#: inc/WPOptimizer/Settings.php:256
msgid "Revisions number"
msgstr ""

#: inc/WPOptimizer/Settings.php:257
msgid "Sets the maximum number of post revisions to keep. Applied on the next post save. Set to 0 to disable revisions and remove existing ones on save."
msgstr ""

#: inc/WPOptimizer/Settings.php:270
msgid "Post Types for Revision Limiting"
msgstr ""

#: inc/WPOptimizer/Settings.php:271
msgid "Select which post types should have revision limiting applied. Leave empty to apply to all post types."
msgstr ""

#: inc/WPOptimizer/Settings.php:282
msgid "Disable Heartbeat"
msgstr ""

#: inc/WPOptimizer/Settings.php:283
msgid "Disables the WordPress Heartbeat API in the admin, reducing AJAX requests. May affect autosave and real-time features."
msgstr ""

#: inc/WPOptimizer/Settings.php:290
msgid "Slow Heartbeat"
msgstr ""

#: inc/WPOptimizer/Settings.php:291
msgid "Increases the interval of the Heartbeat API to reduce server load. Recommended for high-traffic sites."
msgstr ""

#: inc/WPOptimizer/Settings.php:302
msgid "Remove WP Embed"
msgstr ""

#: inc/WPOptimizer/Settings.php:303
msgid "Removes the WP Embed script, which enables embedding content from other sites. Recommended if you do not use embeds."
msgstr ""

#: inc/WPOptimizer/Settings.php:310
msgid "Disable XML Sitemaps"
msgstr ""

#: inc/WPOptimizer/Settings.php:311
msgid "Disables the default WordPress XML sitemaps. Enable if you use a third-party SEO plugin or want to hide your sitemap for privacy."
msgstr ""

#: inc/WPOptimizer/Settings.php:318
msgid "Disable Self Pingbacks"
msgstr ""

#: inc/WPOptimizer/Settings.php:319
msgid "Prevents WordPress from sending pingbacks to your own site when linking to your own posts. Reduces unnecessary database entries and notifications."
msgstr ""

#: inc/WPOptimizer/Settings.php:326
msgid "Disable Dashicons on Frontend"
msgstr ""

#: inc/WPOptimizer/Settings.php:327
msgid "Prevents loading of Dashicons (admin icon font) for non-logged-in users, reducing HTTP requests and improving frontend performance."
msgstr ""

#: inc/WPOptimizer/Settings.php:334
msgid "Limit Autosave Interval"
msgstr ""

#: inc/WPOptimizer/Settings.php:335
msgid "Increases the autosave interval to reduce server load. Recommended for busy sites. Default is 60 seconds; this sets it to 5 minutes."
msgstr ""

#: inc/WPOptimizer/Settings.php:342
msgid "Disable Author Archives"
msgstr ""

#: inc/WPOptimizer/Settings.php:343
msgid "Disables author archive pages to prevent user enumeration and improve SEO. Redirects author pages to the homepage."
msgstr ""

#: inc/WPOptimizer/Settings.php:350
msgid "Block REST API Users for Guests"
msgstr ""

#: inc/WPOptimizer/Settings.php:351
msgid "Removes the /wp-json/wp/v2/users endpoint for non-logged-in users while keeping the rest of the REST API public. Disable this if a headless frontend or plugin needs to fetch user data anonymously (better: authenticate the headless app via application password)."
msgstr ""

#: inc/WPOptimizer/Settings.php:358
msgid "Block ?author= Enumeration"
msgstr ""

#: inc/WPOptimizer/Settings.php:359
msgid "Strips the author query var from frontend requests, preventing the /?author=N → /author/<login>/ redirect that leaks login slugs. Disable if a custom archive or plugin uses ?author=N for legitimate filtering."
msgstr ""

#: inc/WPOptimizer/Settings.php:366
msgid "Remove Users Sitemap"
msgstr ""

#: inc/WPOptimizer/Settings.php:367
msgid "Removes /wp-sitemap-users-*.xml from WordPress core sitemaps so the list of authors with published posts is no longer publicly indexed."
msgstr ""

#: inc/WPOptimizer/Settings.php:374
msgid "Generic Login Errors"
msgstr ""

#: inc/WPOptimizer/Settings.php:375
msgid "Replaces specific login error messages (\"Unknown username\", \"The password you entered…\") with a single neutral message, preventing username confirmation via the login form."
msgstr ""

#: inc/WPOptimizer/Settings.php:382
msgid "Hide Login URL"
msgstr ""

#: inc/WPOptimizer/Settings.php:383
msgid "Serve wp-login.php on a custom URL slug and redirect direct /wp-login.php access to the homepage. Deactivate conflicting hide-login plugins first. Save a valid slug before enabling to avoid lockout."
msgstr ""

#: inc/WPOptimizer/Settings.php:390
msgid "Custom Login Slug"
msgstr ""

#: inc/WPOptimizer/Settings.php:391
msgid "Custom path segment for the login screen (e.g. my-secret-login). Must be at least 3 characters and must not match a reserved WordPress path, published content slug, or public rewrite base."
msgstr ""

#: inc/WPOptimizer/Settings.php:402
msgid "Enforce Display Name ≠ Username"
msgstr ""

#: inc/WPOptimizer/Settings.php:403
msgid "On profile save, blocks setting Display Name equal to the login username. Prevents the login slug from leaking through bylines, oEmbed, feeds, and REST. Existing users are not auto-changed — only new saves are validated."
msgstr ""

#: inc/WPOptimizer/Settings.php:410
msgid "Disable Attachment Pages"
msgstr ""

#: inc/WPOptimizer/Settings.php:411
msgid "Redirects attachment pages to the parent post or homepage to prevent thin content and improve SEO."
msgstr ""

#: inc/WPOptimizer/Settings.php:419
msgid "REST API access for guests"
msgstr ""

#: inc/WPOptimizer/Settings.php:420
msgid "Open: WordPress default. Allowlist: guests may only call the namespaces ticked below. Closed: guests get no REST API at all. Logged-in users and application passwords are never affected."
msgstr ""

#: inc/WPOptimizer/Settings.php:423
msgid "Open (WordPress default)"
msgstr ""

#: inc/WPOptimizer/Settings.php:432
msgid "Hide REST index for guests"
msgstr ""

#: inc/WPOptimizer/Settings.php:433
msgid "Guests get 401 for /wp-json/ and the namespace index routes, and the REST discovery links are removed for them. In Closed mode this always applies."
msgstr ""

#: inc/WPOptimizer/Settings.php:441
msgid "Namespaces guests may call"
msgstr ""

#: inc/WPOptimizer/Settings.php:442
msgid "Unticked namespaces return 401 rest_forbidden_guest for guests. Namespaces that appear later stay blocked until you tick them."
msgstr ""

#: inc/WPOptimizer/Settings.php:461
msgid "Remove Patterns Menu"
msgstr ""

#: inc/WPOptimizer/Settings.php:462
msgid "Removes the Patterns submenu from Appearance menu in admin. Useful for sites not using Full Site Editing patterns."
msgstr ""

#: inc/WPOptimizer/Settings.php:469
msgid "Content Order"
msgstr ""

#: inc/WPOptimizer/Settings.php:470
msgid "Enable custom ordering of various \"hierarchical\" content types or those supporting \"page attributes\". A new 'Order' sub-menu will appear for enabled content type(s). The \"All {Posts}\" list page for enabled post types in wp-admin will automatically use the custom order."
msgstr ""

#: inc/WPOptimizer/Settings.php:477
msgid "Post Types for Content Ordering"
msgstr ""

#: inc/WPOptimizer/Settings.php:478
msgid "Select which post types should have custom ordering enabled. Only hierarchical post types and those supporting page attributes can be ordered (taxonomies are not supported). Leave empty to apply to all supported post types."
msgstr ""

#: inc/WPOptimizer/Settings.php:489
msgid "Media Replacement"
msgstr ""

#: inc/WPOptimizer/Settings.php:490
msgid "Enable media replacement functionality. Adds a \"Replace Media\" button to attachment edit screens, allowing you to replace media files while keeping the same ID, URL, and metadata."
msgstr ""

#: inc/WPOptimizer/Settings.php:497
msgid "Disable Block Styles"
msgstr ""

#: inc/WPOptimizer/Settings.php:498
msgid "Removes Gutenberg block styles from frontend. Recommended for classic themes or sites not using blocks. Saves ~50KB of CSS."
msgstr ""

#: inc/WPOptimizer/Settings.php:505
msgid "Disable Embeds"
msgstr ""

#: inc/WPOptimizer/Settings.php:506
msgid "Disables WordPress oEmbed functionality. Prevents embedding content from other sites and improves security. Saves ~10KB of JavaScript."
msgstr ""

#: inc/WPOptimizer/Settings.php:513
msgid "Disable Application Passwords"
msgstr ""

#: inc/WPOptimizer/Settings.php:514
msgid "Disables WordPress 5.6+ application passwords feature. Improves security by preventing external API access via generated passwords."
msgstr ""

#: inc/WPOptimizer/Settings.php:521
msgid "Remove Global Styles & SVG Filters"
msgstr ""

#: inc/WPOptimizer/Settings.php:522
msgid "Removes Full Site Editing global styles and SVG filters for classic themes. Reduces CSS output and improves performance."
msgstr ""

#: inc/WPOptimizer/Settings.php:540
msgid "Settings were not saved: the form was cut off by the server. Raise max_input_vars and save again."
msgstr ""
