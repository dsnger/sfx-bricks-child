msgstr ""

#: inc/SiteCheck/Catalogue.php:89
msgid "phpinfo and test scripts"
msgstr ""

#: inc/SiteCheck/Catalogue.php:90
msgid "phpinfo() and test scripts show server paths, PHP modules and settings, a map for attackers. An unknown script in the root folder can also be left over from an attack."
msgstr ""

#: inc/SiteCheck/Catalogue.php:91
msgid "Delete the scripts listed after checking what they are."
msgstr ""

#: inc/SiteCheck/Catalogue.php:93
msgid "Open each file listed in the host's file manager and look at what it does."
msgstr ""

#: inc/SiteCheck/Catalogue.php:94
msgid "Delete test scripts you no longer need."
msgstr ""

#: inc/SiteCheck/Catalogue.php:95
msgid "If you do not recognise a script, treat it as suspicious: keep a copy for analysis, delete it and change the passwords."
msgstr ""

