msgstr ""

#: inc/SecurityHeader/AdminPage.php:144
msgid "Disable X-Frame-Options Header"
msgstr ""

#: inc/SecurityHeader/AdminPage.php:147
msgid "Disable the X-Frame-Options header if you need to resolve conflicts or for debugging."
msgstr ""

#: inc/SecurityHeader/AdminPage.php:157
msgid "Security Header Tips"
msgstr ""

#: inc/SecurityHeader/AdminPage.php:159
msgid "Always test new header settings on a staging site before deploying to production."
msgstr ""

#: inc/SecurityHeader/AdminPage.php:160
msgid "Use the browser console and security tools to verify headers are set as expected."
msgstr ""

#: inc/SecurityHeader/AdminPage.php:161
msgid "If you experience issues with embedded content or third-party services, review your CSP and X-Frame-Options settings."
msgstr ""

#: inc/SecurityHeader/AdminPage.php:162
msgid "For maximum security, enable HSTS with preload and includeSubDomains, but only if all subdomains use HTTPS."
