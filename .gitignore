# Gitignore is not the production zip filter.
# Clone this repo and you should have everything needed to keep developing:
# tests, docs, Cursor rules, Claude commands, bin/ scripts, composer.lock.
# What a release ships is the SHIPPED allowlist in bin/plugin.conf, not this file.

# OS generated files
.DS_Store
.DS_Store*
Thumbs.db/
Thumbs.db*

# IDE files (Cursor rules in .cursor/rules/ stay tracked)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Composer: lockfile is tracked; install dependencies with `composer install`
/vendor/

# Node dependencies and build artifacts
/node_modules/
/npm-debug.log
/yarn-error.log
/dist/
/build/

# Log files
*.log

# WordPress core files (never commit core)
/wp-admin/
/wp-includes/

# Environment files (.env.local is local-only; env-example.txt stays tracked)
.env
.env.*

# Local AI / agent session state (shared rules and commands stay tracked)
.remember/
.conductor/
.superpowers/
.cloud/
.claude/settings.local.json
.claude/worktrees/

# Backup and temp files
*.bak
*.tmp
*.swp

# Ignore uploads (optional, comment out if you want to track uploads)
# /wp-content/uploads/

# Ignore database exports
*.sql
*.sql.gz

# Ignore custom cache or cache plugins
/wp-content/cache/

# Allow theme and plugin files
!wp-content/themes/sfx-bricks-child/**
!wp-content/plugins/**

# Ignore build artifacts (keep *.sh tracked — bin/release.sh / bin/test-instance.sh are repo scripts)
*.zip
# the removed build-theme.sh's per-run temp archive, if one is still lying around
.*.zip.??????
*.tar
*.gz
*.bz2
*.rar
*.7z
*.iso
*.dmg
*.pkg
*.deb
*.rpm

# Codex gate state: review artifacts and the hook's per-workspace counters and
# markers. The .context/codex-gate.on adoption marker is committed and must stay
# tracked, so it is negated back in explicitly.
/.context/codex-reviews/
/.context/codex-gate.*
!/.context/codex-gate.on

# mcp-codex-dev writes per-run session state here; .mcp.json itself stays tracked.
/.mcp/

# dev-workflow gate hook: per-clone state, never committed. The exceptions are
# settings a person writes and the hook only reads.
.context/codex-gate.*
!.context/codex-gate.on
!.context/codex-gate.off
!.context/codex-gate.floor
!.context/codex-gate.cap
!.context/codex-gate.tools
